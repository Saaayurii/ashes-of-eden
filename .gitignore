# Audio build cache (re-downloadable, see tools/audio/build_audio.py)
tools/audio/.cache/

# Godot
.godot/
*.import
# …except the painted panels: lossy WebP (q 0.85) is a deliberate choice, 21 → 5 MB
!assets/levels/*_wide.png.import
localization/*.translation
export_presets.cfg.bak
.editor/

# Official content overlay (private ashes-of-eden-content repo, see docs/MONETIZATION.md)
content/

# Builds
build/
dist/
*.apk
*.apk.idsig
*.aab

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Godot export secrets (never commit)
*.keystore
*.jks

# Local tooling, not part of the game (a Claude Code install, editor preview config)
node_modules/
package.json
package-lock.json
.claude/

# Python bytecode
__pycache__/
*.pyc

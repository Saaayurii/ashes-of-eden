# Audio build cache (re-downloadable, see tools/audio/build_audio.py)
tools/audio/.cache/

# Godot
.godot/
*.import
# …except the painted panels: lossy WebP (q 0.85) is a deliberate choice, 21 → 5 MB
!assets/levels/*_wide.png.import
# …and the panels behind them, and the bestiary portraits, for the same reason.
# These are painted pictures, not pixel art: lossy costs nothing anybody can see
# and the Web build is the one paying. Without these lines a fresh checkout
# re-imports them lossless and the saving silently disappears in CI.
!assets/levels/depth/*_wide.png.import
!assets/portraits/*.png.import
!assets/sprites/enemy_atlases/*.png.import
# …and the other painted plates the size of a screen: the cutscene stills, the
# three interiors and the hell gate's atmosphere (tools/export/music_filters.py)
!assets/cutscenes/*.png.import
!assets/levels/*_v1.png.import
!assets/levels/depth/hell_gate_atmosphere_v2.png.import
localization/*.translation
export_presets.cfg.bak
.editor/

# Official content overlay (private ashes-of-eden-content repo, see docs/MONETIZATION.md)
content/

# Builds
build/
dist/
*.apk
*.apk.idsig
*.aab

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Godot export secrets (never commit)
*.keystore
*.jks

# Local tooling, not part of the game (a Claude Code install, editor preview config)
node_modules/
package.json
package-lock.json
.claude/

# Python bytecode
__pycache__/
*.pyc

# g2pW lookup tables, fetched on demand by the Chinese phonemizer
# (tools/audio/generate_speech.py, see docs/VOICE.md)
g2pW/

# Noto Sans SC before subsetting: 18 MB, re-downloadable
# (tools/art/make_cjk_font.py). The subset it produces is committed.
tools/art/.cache/
tools/studio/import/

{
  "id": "ch4_finale",
  "steps": [
    {"do": "hold"},
    {"do": "letterbox", "on": true, "time": 0.5},
    {"do": "camera", "to": "boss", "zoom": 1.2, "time": 1.0},
    {"do": "fx", "kind": "sparkle", "at": "boss", "offset": [0, -40], "color": "#fff0b0", "amount": 18, "width": 24},
    {"do": "dialogue", "id": "ch4_prince_fall", "cast": {"SPEAKER_PRINCE_OF_TYRE": "boss", "SPEAKER_ELIAN": "player"}, "zoom": 1.25},
    {"do": "flash", "color": "#fff6d6", "strength": 0.6, "time": 1.0, "if": "light_returned"},
    {"do": "dialogue", "id": "ch4_finale_returned", "if": "light_returned"},
    {"do": "fx", "kind": "light", "at": "player", "offset": [0, -30], "color": "#ffcf70", "radius": 140, "time": 2.4, "energy": 1, "if": "light_shared"},
    {"do": "dialogue", "id": "ch4_finale_shared", "if": "light_shared"},
    {"do": "fx", "kind": "light", "at": "player", "offset": [0, -44], "color": "#fff0b0", "radius": 90, "time": 2.4, "energy": 1.1, "if": "light_taken"},
    {"do": "dialogue", "id": "ch4_finale_taken", "cast": {"SPEAKER_PRINCE_OF_TYRE": "boss"}, "if": "light_taken"},
    {"do": "dialogue", "id": "ch4_finale_silent", "unless": ["light_returned", "light_shared", "light_taken"]},
    {"do": "camera", "to": "player", "zoom": 1.2, "time": 1.0},
    {"do": "dialogue", "id": "ch4_finale_zacchaeus_down", "if": "zacchaeus_down"},
    {"do": "dialogue", "id": "ch4_finale_zacchaeus_sold", "if": "zacchaeus_sold"},
    {"do": "dialogue", "id": "ch4_finale_lydia_gave", "if": "lydia_gave"},
    {"do": "dialogue", "id": "ch4_finale_lydia_asked", "if": "lydia_asked"},
    {"do": "dialogue", "id": "ch4_finale_lydia_bought", "if": "lydia_bought"},
    {"do": "dialogue", "id": "ch4_finale_lamplighter", "if": ["read_lamplighter_letter", "light_shared"]},
    {"do": "dialogue", "id": "ch4_finale_lamplighter", "if": ["read_lamplighter_letter", "light_returned"]},
    {"do": "dialogue", "id": "ch4_finale_lazarus", "if": "lazarus_helped"},
    {"do": "sound", "name": "bell", "volume": -4},
    {"do": "camera", "to": "door", "zoom": 1.1, "time": 1.4},
    {"do": "dialogue", "id": "ch4_finale_grace", "path": "grace"},
    {"do": "dialogue", "id": "ch4_finale_temptation", "path": "temptation"},
    {"do": "dialogue", "id": "ch4_finale_will", "path": "will"},
    {"do": "fade", "to": 0.55, "time": 1.2},
    {"do": "title", "name": "CHAPTER_IV", "subtitle": "CHAPTER_IV_END", "time": 2.6, "sound": "bell", "volume": -10},
    {"do": "fade", "to": 0.0, "time": 1.0},
    {"do": "camera", "to": "player", "zoom": 1.0, "time": 0.9},
    {"do": "letterbox", "on": false, "time": 0.4},
    {"do": "release"}
  ]
}

{
  "id": "rich_gate_arrival",
  "steps": [
    {"do": "hold"},
    {"do": "letterbox", "on": true, "time": 0.4},
    {"do": "camera", "to": "npc:lazarus_tyre", "zoom": 1.15, "time": 1.2},
    {"do": "appear", "who": "npc:lazarus_tyre", "time": 1.0, "if": "lazarus_helped"},
    {"do": "dialogue", "id": "ch4_rich_gate_lazarus", "cast": {"NPC_LAZARUS": "npc:lazarus_tyre"}, "zoom": 1.25, "if": "lazarus_helped"},
    {"do": "dialogue", "id": "ch4_rich_gate_passed", "if": "lazarus_passed"},
    {"do": "dialogue", "id": "ch4_rich_gate_empty", "unless": ["lazarus_helped", "lazarus_passed"]},
    {"do": "camera", "to": "player", "zoom": 1.0, "time": 0.8},
    {"do": "letterbox", "on": false, "time": 0.3},
    {"do": "release"}
  ]
}

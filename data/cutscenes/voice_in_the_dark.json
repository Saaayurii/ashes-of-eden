{
  "id": "voice_in_the_dark",
  "steps": [
    {"do": "hold"},
    {"do": "letterbox", "on": true, "time": 0.5},
    {"do": "camera", "to": "player", "zoom": 1.1, "time": 0.6},
    {"do": "fade", "to": 0.7, "time": 1.4},
    {"do": "sound", "name": "thunder", "volume": -16},
    {"do": "flash", "color": "#5a0a0a", "strength": 0.35, "time": 1.4},
    {"do": "camera", "to": "player", "zoom": 1.22, "time": 2.4},
    {"do": "dialogue", "id": "voice_catacombs"},
    {"do": "flash", "color": "#8a1010", "strength": 0.6, "time": 0.9, "if": "voice_yes"},
    {"do": "shake", "strength": 3, "if": "voice_yes"},
    {"do": "sound", "name": "thunder", "volume": -8, "if": "voice_yes"},
    {"do": "sound", "name": "bell", "volume": -14, "if": "voice_no"},
    {"do": "flash", "color": "#d8d0c0", "strength": 0.25, "time": 1.2, "if": "voice_no"},
    {"do": "wait", "time": 1.6, "if": "voice_silent"},
    {"do": "wait", "time": 0.6},
    {"do": "camera", "to": "player", "zoom": 1.0, "time": 1.2},
    {"do": "fade", "to": 0.0, "time": 1.4},
    {"do": "letterbox", "on": false, "time": 0.4},
    {"do": "release"}
  ]
}

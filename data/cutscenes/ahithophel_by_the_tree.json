{
  "id": "ahithophel_by_the_tree",
  "steps": [
    {"do": "hold"},
    {"do": "letterbox", "on": true, "time": 0.5},
    {"do": "camera", "between": ["player", "npc:ahithophel"], "zoom": 1.1, "time": 1.6},
    {"do": "wait", "time": 0.6},
    {"do": "dialogue", "id": "ch5_ahithophel", "cast": {"SPEAKER_AHITHOPHEL": "npc:ahithophel", "SPEAKER_ELIAN": "player"}, "zoom": 1.3},
    {"do": "dialogue", "id": "ch5_ahithophel_stayed", "cast": {"SPEAKER_AHITHOPHEL": "npc:ahithophel", "SPEAKER_ELIAN": "player"}, "zoom": 1.3, "if": "ahithophel_stayed"},
    {"do": "dialogue", "id": "ch5_ahithophel_lied", "cast": {"SPEAKER_AHITHOPHEL": "npc:ahithophel", "SPEAKER_ELIAN": "player"}, "zoom": 1.3, "if": "ahithophel_lied"},
    {"do": "fx", "kind": "sparkle", "at": "npc:ahithophel", "offset": [-18, -4], "color": "#d8a0c0", "amount": 10, "if": "ahithophel_lied"},
    {"do": "face", "who": "npc:ahithophel", "dir": 1, "if": "ahithophel_told"},
    {"do": "dialogue", "id": "ch5_ahithophel_told", "cast": {"SPEAKER_AHITHOPHEL": "npc:ahithophel", "SPEAKER_ELIAN": "player"}, "zoom": 1.3, "if": "ahithophel_told"},
    {"do": "camera", "to": "player", "zoom": 1.0, "time": 0.8},
    {"do": "letterbox", "on": false, "time": 0.3},
    {"do": "release"}
  ]
}

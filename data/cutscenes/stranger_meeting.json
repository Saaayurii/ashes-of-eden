{
  "id": "stranger_meeting",
  "steps": [
    {"do": "hold"},
    {"do": "letterbox", "on": true, "time": 0.4},
    {"do": "face", "who": "player", "dir": 1},
    {"do": "wait", "time": 0.3},
    {"do": "sound", "name": "summon", "volume": -12},
    {"do": "fx", "kind": "ash", "at": "npc:stranger", "offset": [0, -20], "color": "#6a6478", "amount": 18},
    {"do": "appear", "who": "npc:stranger", "time": 1.2},
    {"do": "camera", "between": ["player", "npc:stranger"], "zoom": 1.15, "time": 1.1},
    {"do": "dialogue", "id": "ch1_stranger", "cast": {"SPEAKER_STRANGER": "npc:stranger", "SPEAKER_ELIAN": "player"}, "zoom": 1.3},
    {"do": "walk", "who": "player", "to": "npc:stranger", "offset": [-24, 0], "run": true, "time": 0.55, "if": "stranger_killed"},
    {"do": "anim", "who": "player", "anim": "thrust", "if": "stranger_killed"},
    {"do": "wait", "time": 0.15, "if": "stranger_killed"},
    {"do": "flash", "color": "#f4e8d8", "strength": 0.55, "time": 0.35, "if": "stranger_killed"},
    {"do": "shake", "strength": 4, "if": "stranger_killed"},
    {"do": "vanish", "who": "npc:stranger", "ash": true, "time": 0.35, "if": "stranger_killed"},
    {"do": "wait", "time": 0.5, "if": "stranger_killed"},
    {"do": "camera", "to": "player", "zoom": 1.3, "time": 0.6, "if": "stranger_killed"},
    {"do": "dialogue", "id": "ch1_stranger_after_kill", "if": "stranger_killed"},
    {"do": "dialogue", "id": "ch1_stranger_after_listen", "cast": {"SPEAKER_STRANGER": "npc:stranger"}, "zoom": 1.3, "if": "stranger_heard"},
    {"do": "fx", "kind": "ash", "at": "npc:stranger", "offset": [0, -20], "color": "#6a6478", "amount": 16, "if": "stranger_heard"},
    {"do": "vanish", "who": "npc:stranger", "time": 1.6, "if": "stranger_heard"},
    {"do": "dialogue", "id": "ch1_stranger_after_leave", "cast": {"SPEAKER_STRANGER": "npc:stranger"}, "zoom": 1.3, "if": "stranger_refused"},
    {"do": "vanish", "who": "npc:stranger", "time": 1.0, "if": "stranger_refused"},
    {"do": "vanish", "who": "npc:stranger", "time": 0.8, "unless": ["stranger_killed", "stranger_heard", "stranger_refused"]},
    {"do": "camera", "to": "player", "zoom": 1.0, "time": 0.8},
    {"do": "letterbox", "on": false, "time": 0.3},
    {"do": "release"}
  ]
}

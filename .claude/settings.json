{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash tools/setup_artist.sh*)",
      "Bash(python3 tools/studio/*)",
      "Bash(python3 tools/art/*)",
      "Bash(python3 tools/check_generators.py*)",
      "Bash(python3 -m unittest discover -s tools/studio/tests*)",
      "Bash(python3 .claude/skills/ref2game/scripts/*)",
      "Bash(node .claude/skills/ref2game/scripts/*)",
      "Bash(node --test tools/studio/tests/*)",
      "Bash(/Applications/Godot.app/Contents/MacOS/Godot --headless --path . -s scripts/tools/*)",
      "Bash(make validate)",
      "Bash(make import)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(ls*)",
      "Bash(file *)",
      "Bash(mkdir -p art-inbox/*)",
      "Bash(cp ~/Downloads/* art-inbox/*)",
      "Edit(art-inbox/**)",
      "Write(art-inbox/**)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push * main:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(gh pr merge*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Edit(~/.ssh/**)", "Write(~/.ssh/**)",
      "Edit(~/.gitconfig)", "Write(~/.gitconfig)",
      "Edit(~/.zshrc)", "Write(~/.zshrc)",
      "Edit(~/.zprofile)", "Write(~/.zprofile)",
      "Edit(~/.bashrc)", "Write(~/.bashrc)",
      "Edit(~/.bash_profile)", "Write(~/.bash_profile)",
      "Edit(~/.claude/**)", "Write(~/.claude/**)",
      "Edit(~/Library/**)", "Write(~/Library/**)",
      "Edit(//etc/**)", "Write(//etc/**)",
      "Edit(//usr/**)", "Write(//usr/**)",
      "Edit(//Applications/**)", "Write(//Applications/**)"
    ]
  }
}

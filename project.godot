; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ashes of Eden"
config/description="Open-source 2D pixel action roguelite about a soul caught between Heaven and the Abyss."
config/version="0.1.0-alpha.1"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Data="*res://scripts/autoload/data_loader.gd"
Game="*res://scripts/autoload/game.gd"
Settings="*res://scripts/autoload/settings.gd"
Audio="*res://scripts/autoload/audio.gd"
Profile="*res://scripts/autoload/profile.gd"
Juice="*res://scripts/autoload/juice.gd"
Fx="*res://scripts/autoload/fx.gd"
Net="*res://scripts/autoload/net.gd"
Saves="*res://scripts/autoload/saves.gd"
Playtest="*res://scripts/autoload/playtest.gd"
Curtain="*res://scenes/ui/curtain.tscn"
NetOverlay="*res://scripts/ui/net_overlay.gd"
FrameMeter="*res://scripts/autoload/frame_meter.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/ui/theme.tres"

